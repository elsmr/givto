{
  "name": "givto",
  "version": "1.0.0",
  "description": "Secret Santa app",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "docker compose up -d --wait && next dev",
    "cron": "node --env-file=.env.development scripts/cron.mjs",
    "seed": "node --env-file=.env.development --import ./tests/ts-hooks.mjs scripts/seed.ts",
    "build": "next build",
    "start": "next start",
    "tsc": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:api": "playwright test -c e2e/playwright.config.ts api/",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts flows/ a11y/"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.18",
    "@react-email/render": "^2.2.0",
    "@sentry/nextjs": "^11.11.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.26.0",
    "@trpc/server": "^11.26.0",
    "@trpc/tanstack-react-query": "^11.26.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.8.0",
    "motion": "^14.11.1",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "pino": "^10.4.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsqr": "1.4.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
