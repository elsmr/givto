MONGODB_URI=mongodb+srv://str
MONGODB_DB=dbname
MAILGUN_API_KEY=key
MAILGUN_API_BASE=https://api.eu.mailgun.net/v3/domain
BETTER_AUTH_URL=https://givto.app
BETTER_AUTH_SECRET=at-least-32-random-characters
# Optional: Sign in with Google. Also needed at build time (shows the button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
NEXT_PUBLIC_SENTRY_DSN=https://sentry-dsn
