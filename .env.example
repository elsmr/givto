MONGODB_URI=mongodb+srv://str
MONGODB_DB=dbname
MAILGUN_API_KEY=key
MAILGUN_API_BASE=https://api.eu.mailgun.net/v3/domain
BETTER_AUTH_URL=https://givto.app
BETTER_AUTH_SECRET=at-least-32-random-characters
# Whoever runs this instance: the contact on /privacy (read at build time; the build fails without them).
# OWNER_EMAIL also gets a daily email listing new groups (name and organizer email), when there are any.
OWNER_NAME=Your Name
OWNER_EMAIL=you@example.com
# Optional: Sign in with Google. Also needed at build time (shows the button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
NEXT_PUBLIC_SENTRY_DSN=https://sentry-dsn
