# Local development (`next dev` loads this over .env). Safe, dev-only values for every variable the
# app reads; services from docker-compose.yml. Production secrets live in Vercel only.
# Next's order: process env > .env.development.local > .env.local > .env.development > .env,
# so don't keep production values in .env.local either.

MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=givto_dev

# The mail mock (inbox at http://localhost:3091)
MAILGUN_API_BASE=http://localhost:3091
MAILGUN_API_KEY=dev-key
MAILGUN_WEBHOOK_SIGNING_KEY=dev-webhook-signing-key

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-secret-never-use-in-production
BETTER_AUTH_TELEMETRY=0

# `pnpm cron <job>` sends this
CRON_SECRET=dev-cron-secret

LOG_LEVEL=debug

# Blank on purpose, so values in a local .env don't apply: no Sentry, no test-only procedures.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
E2E_TEST_HOOKS=
VERCEL_ENV=
# Legacy (old app)
JWT_SECRET_KEY=
APP_HOST=
